# Frontend production environment variables
#
# REPLACE the URL below with your actual Fly.io app URL after deploying the backend.
# It will look like https://YOUR-APP-NAME.fly.dev
#
# This file should be committed to your repo so Cloudflare Pages picks it up
# at build time. Do NOT put secrets here — anything in REACT_APP_* is bundled
# into the public JavaScript.

REACT_APP_API_URL=https://fourcolor-api.fly.dev
